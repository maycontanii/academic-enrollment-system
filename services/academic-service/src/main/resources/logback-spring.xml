<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSON-structured logs. The LogstashEncoder includes the SLF4J MDC, where Micrometer Tracing places
  traceId/spanId, so every line carries the trace that HTTP and the broker propagate. A "service"
  field distinguishes the two services when their logs are aggregated together.
-->
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="app"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
            <customFields>{"service":"${appName}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
